# Copy this file to .env and fill in real values. Never commit .env.

# --- LINE Messaging API ---
# Channel access token (long-lived), from LINE Developers Console > Messaging API tab.
LINE_CHANNEL_ACCESS_TOKEN=

# Your own LINE userId (starts with "U..."), captured once via webhook_capture.py.
LINE_TO_USER_ID=

# --- Cloudflare R2 (S3-compatible object storage for chart images) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=qm-bot-charts
# Public base URL for the bucket (r2.dev subdomain or your own custom domain), no trailing slash.
R2_PUBLIC_BASE_URL=
