[Unit]
Description=Send the daily Bitcoin trend report at 10:00 Thailand time

[Timer]
# The VM's clock is set to Asia/Bangkok (see setup_vm.sh), and the zone is
# named explicitly here as well so the schedule stays correct even if the
# host timezone is ever changed.
OnCalendar=*-*-* 10:00:00 Asia/Bangkok
# If the VM was off at 10:00, send as soon as it comes back rather than
# skipping the day silently.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
