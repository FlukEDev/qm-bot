[Unit]
Description=QM Pattern Signal Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qmbot
Group=qmbot
WorkingDirectory=/opt/qmbot
ExecStart=/opt/qmbot/.venv/bin/python /opt/qmbot/bot.py --config /opt/qmbot/config.yaml --loop --interval 3600
Restart=on-failure
RestartSec=30
# bot.py ignores SIGINT while --loop is set (see bot.py's main()) and treats
# SIGTERM as "stop the loop after the current scan" — systemd's default stop
# signal is SIGTERM, so `systemctl stop qmbot` already does the right thing
# with no KillSignal override needed here.

[Install]
WantedBy=multi-user.target
